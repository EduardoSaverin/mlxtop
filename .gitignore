.ssh/
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa*
id_ed25519*
ssh_host_*_key
ssh_host_*_key.pub
*.ppk
authorized_keys
known_hosts

# Python helper caches
__pycache__/
*.py[cod]
